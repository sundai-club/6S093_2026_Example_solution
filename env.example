# Workshop 1: LLM and Mastodon Integration

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=...

# Mastodon credentials
# Get access token from: Your Mastodon Instance -> Preferences -> Development -> New Application
MASTODON_ACCESS_TOKEN=...
MASTODON_INSTANCE_URL=https://mastodon.social

NOTION_API_KEY=...
# Get page ID from taking later part of URL: https://www.notion.so/Business-docs-2eded15b727f80729ae9c00d3f899a43
NOTION_PARENT_PAGE_ID=2eded15b727f80729ae9c00d3f899a43     
#  In Notion connect your page to integration:                                                                                                             
#   1. Open your "Business docs" page                                                                                      
#   2. Click the "..." button (top right corner)                                                                           
#   3. Scroll down and find "Connections" (or it might say "Add connections")                                              
#   4. Click it → Search for "social media agent" → Click to add it                                                        
